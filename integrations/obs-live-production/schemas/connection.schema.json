{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private OBS individual-source server connection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "serverUrl",
    "sourceHost",
    "caCertificatePem",
    "password"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "serverUrl": {
      "type": "string",
      "pattern": "^https://"
    },
    "sourceHost": {
      "type": "string",
      "minLength": 1
    },
    "caCertificatePem": {
      "type": "string",
      "minLength": 1
    },
    "password": {
      "type": "string",
      "minLength": 16
    }
  }
}
