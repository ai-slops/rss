{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Live Production OBS Fixture Control",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "commands"],
  "properties": {
    "schemaVersion": {"const": 1},
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "senderBundle", "sourceId", "sourceName", "color", "frameCounter", "toneHz", "audioMixIndex"],
            "properties": {
              "kind": {"const": "configureNativeFixtureSource"},
              "senderBundle": {"type": "string", "minLength": 1},
              "sourceId": {"type": "string", "minLength": 1},
              "sourceName": {"type": "string", "minLength": 1},
              "color": {"enum": ["red", "blue"]},
              "frameCounter": {"const": true},
              "toneHz": {"type": "integer", "minimum": 1},
              "audioMixIndex": {"type": "integer", "minimum": 0, "maximum": 5}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "senderBundle", "expected"],
            "properties": {
              "kind": {"enum": ["startBadAuthSender", "startDuplicateSender"]},
              "senderBundle": {"type": "string", "minLength": 1},
              "expected": {"const": "rejected"}
            }
          }
        ]
      }
    }
  }
}
