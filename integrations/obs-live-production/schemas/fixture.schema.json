{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Live Production OBS Local Fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "localFixtureOnly", "senders", "reportFile", "controlFile", "deadlineSeconds"],
  "properties": {
    "schemaVersion": {"const": 1},
    "localFixtureOnly": {"const": true},
    "senders": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "reportFile": {"type": "string", "minLength": 1},
    "controlFile": {"type": "string", "minLength": 1},
    "deadlineSeconds": {"type": "integer", "minimum": 1, "maximum": 600}
  }
}
