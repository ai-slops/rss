{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Live Production OBS Recovery Command",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "commandId", "kind"],
  "properties": {
    "schemaVersion": {"const": 1},
    "commandId": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "kind": {"enum": ["dropPublisher", "freezePublisher", "manualStopAfterQueuedRestart", "pollMissingAuthorization", "pollWrongSourceAuthorization", "exhaustRetryBudget", "reconnectController", "redeliverDuplicateAction", "observeServerRestart", "setMaintenance", "setSourceDisabled", "letControllerLeaseExpire", "pauseActionDispatch", "resumeActionDispatch"]},
    "durationMs": {"type": "integer", "minimum": 1, "maximum": 30000}
  }
}
