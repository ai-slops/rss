{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Live Production OBS Recovery Fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "localFixtureOnly", "sourceId", "publisherBundle", "reportFile", "commandFile", "deadlineSeconds", "operations"],
  "properties": {
    "schemaVersion": {"const": 1},
    "localFixtureOnly": {"const": true},
    "sourceId": {"type": "string", "minLength": 1},
    "publisherBundle": {"type": "string", "minLength": 1},
    "reportFile": {"type": "string", "minLength": 1},
    "commandFile": {"type": "string", "minLength": 1},
    "deadlineSeconds": {"type": "integer", "minimum": 1, "maximum": 600},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind"],
        "properties": {
          "kind": {"enum": ["dropPublisher", "freezePublisher", "manualStopAfterQueuedRestart", "pollMissingAuthorization", "pollWrongSourceAuthorization", "exhaustRetryBudget", "reconnectController", "redeliverDuplicateAction", "observeServerRestart", "setMaintenance", "setSourceDisabled", "letControllerLeaseExpire", "pauseActionDispatch", "resumeActionDispatch"]},
          "durationMs": {"type": "integer", "minimum": 1, "maximum": 30000}
        }
      }
    }
  }
}
